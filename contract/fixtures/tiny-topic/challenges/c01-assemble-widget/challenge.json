{
  "contractVersion": 1,
  "id": "c01",
  "title": "Validate a widget build order",
  "afterChapter": "ch02",
  "exercises": ["widget-anatomy", "torque-spec"],
  "language": "typescript",
  "estimatedHours": 1,
  "brief": "brief.md",
  "rubric": "rubric.md",
  "interface": {
    "entrypoint": "work/src/index.ts",
    "exports": [
      {
        "name": "checkBuild",
        "signature": "(build: Build) => Problem[]",
        "description": "Return every problem in a proposed widget build, empty array when the build is sound."
      }
    ]
  },
  "eval": {
    "runner": "vitest",
    "spec": ".hidden/eval/c01.eval.ts",
    "metrics": [
      { "name": "detection-rate", "threshold": 0.9, "direction": "gte" },
      { "name": "false-positive-rate", "threshold": 0.1, "direction": "lte" }
    ]
  },
  "reference": ".hidden/solution"
}
