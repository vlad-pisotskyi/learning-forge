{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(./topics/*/challenges/*/work/**)",
      "Edit(./topics/*/challenges/*/work/**)",
      "MultiEdit(./topics/*/challenges/*/work/**)",
      "NotebookEdit(./topics/*/challenges/*/work/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|NotebookRead|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/src/hook-guard.ts\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/src/hook-help-log.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/src/hook-help-log.ts\""
          }
        ]
      }
    ]
  }
}
