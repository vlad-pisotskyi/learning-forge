{
  "name": "learning-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A machine that turns a topic name into a complete self-teaching program: cited chapters, graded challenges, and scoped Teacher/Helper/Judge roles.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "forge": "node tools/src/forge.ts",
    "validate": "node tools/src/validate-topic.ts",
    "validate:all": "node tools/src/validate-topic.ts --all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
